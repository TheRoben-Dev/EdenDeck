{
    "file_format_version": "1.2.0",
    "layer": {
        "name": "VK_LAYER_EDENDECK_fsr",
        "type": "GLOBAL",
        "library_path": "@LAYER_LIBRARY_PATH@",
        "api_version": "1.3.0",
        "implementation_version": "@PROJECT_VERSION_MAJOR@@PROJECT_VERSION_MINOR@@PROJECT_VERSION_PATCH@",
        "description": "EdenDeck present hook (phase 1 prototype; FSR and overlay come later)",
        "functions": {
            "vkGetInstanceProcAddr": "edendeck_GetInstanceProcAddr",
            "vkGetDeviceProcAddr": "edendeck_GetDeviceProcAddr",
            "vkNegotiateLoaderLayerInterfaceVersion": "vkNegotiateLoaderLayerInterfaceVersion"
        },
        "enable_environment": {
            "ENABLE_EDENDECK_LAYER": "1"
        },
        "disable_environment": {
            "DISABLE_EDENDECK_LAYER": "1"
        }
    }
}
